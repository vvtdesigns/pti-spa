# Copy this file's contents into Streamlit Community Cloud's
# "Settings -> Secrets" box (do NOT commit a real secrets.toml to GitHub).
#
# DATABASE_URL is what makes the app share one database between your laptop
# and your phone. Get this connection string from Supabase (or any other
# managed Postgres) -- see README.md "Step 2" for exactly where to find it.

DATABASE_URL = "postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres"
